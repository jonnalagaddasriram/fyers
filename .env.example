# ─────────────────────────────────────────────────────────
# Fyers Credentials (required)
# ─────────────────────────────────────────────────────────
FYERS_APP_ID=AAAAAAAAA-100
FYERS_APP_SECRET=YOUR_APP_SECRET
FYERS_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
FYERS_REDIRECT_URL=https://trade.fyers.in/api-login/redirect-uri/index.html

# ─────────────────────────────────────────────────────────
# Trading Mode
# Set DRY_RUN=false ONLY when you are confident in the strategy.
# ─────────────────────────────────────────────────────────
DRY_RUN=true

# ─────────────────────────────────────────────────────────
# Logging
# LOG_LEVEL: debug | info | warn | error
# LOG_FORMAT: json (production) | text (local dev)
# ─────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
ENV=development

# ─────────────────────────────────────────────────────────
# Market Data
# ─────────────────────────────────────────────────────────
RING_BUFFER_SIZE=65536
LATENCY_REPORT_INTERVAL=30s

# ─────────────────────────────────────────────────────────
# Redis
# When using docker-compose, leave this blank — it is
# automatically overridden to redis://redis:6379/0
# When running go run . locally without Docker:
#   set to redis://localhost:6379/0
# Leave blank to run without Redis (NoopStore fallback).
# ─────────────────────────────────────────────────────────
REDIS_URL=
REDIS_STATE_SYNC_INTERVAL=5s
